# pyenv
#   For a library or app, you might want to share this in the project to
#   pin the Python version for all contributors.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, if you're executing system-wide modules, you can spin in a virtualenv.
#   For a project, standard is to gitignore the virtualenv.

# poetry
#   Similar to Pipenv, poetry.lock is generally committed, but the virtualenv should be ignored.
# .venv
# poetry.lock

# pdm
#   Similar to Pipenv and Poetry, pdm.lock is generally committed, but local configuration is ignored.
.pdm-plugins/
.pdm-pyproject.toml

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

